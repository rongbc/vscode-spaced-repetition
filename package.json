{
    "name": "vscode-spaced-repetition",
    "displayName": "Spaced Repetition 间隔重复复习",
    "description": "在 VSCode 中复习 Markdown 笔记里的闪卡:解析语法与调度注释格式兼容 obsidian-spaced-repetition(:: / ::: / 多行 ? 与 ??、<!--SR:!...-->),SM-2 算法调度,支持 #review 整篇笔记复习。",
    "version": "0.2.2",
    "publisher": "local",
    "license": "MIT",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:srs.reviewDueFlashcards",
        "onCommand:srs.reviewAllFlashcards",
        "onCommand:srs.openNotesReviewQueue",
        "onCommand:srs.reviewCurrentNote",
        "onView:srs.dueNotes"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "Spaced Repetition 间隔重复复习",
            "properties": {
                "srs.language": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "en",
                        "zh-cn"
                    ],
                    "enumDescriptions": [
                        "Auto: follow the VS Code UI language / 自动跟随 VS Code 界面语言",
                        "English",
                        "简体中文"
                    ],
                    "default": "auto",
                    "description": "Plugin display language. Follows the VS Code UI language when 'auto'. 插件显示语言;auto 时使用 VS Code 界面语言。"
                },
                "srs.flashcardTags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "#flashcards"
                    ],
                    "description": "标记闪卡牌组的标签(兼容 Obsidian-Spaced-Repetition)。"
                },
                "srs.noteReviewTags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "#review"
                    ],
                    "description": "标记整篇笔记复习的标签。"
                },
                "srs.deckSource": {
                    "type": "string",
                    "enum": [
                        "tag",
                        "folder",
                        "tagAndFolder"
                    ],
                    "enumDescriptions": [
                        "与 OSR 默认一致:仅解析带闪卡标签(#flashcards[…])的笔记,牌组 = 标签路径",
                        "全部笔记参与,牌组 = 文件夹(近似 OSR 的 convertFoldersToDecks)",
                        "仅解析带标签的笔记;标签子路径优先,否则用文件夹"
                    ],
                    "default": "tag",
                    "description": "牌组来源。"
                },
                "srs.ignoreGlobs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/.git/**",
                        "**/.obsidian/**",
                        "**/.vscode/**",
                        "**/.agents/**",
                        "**/.trash/**",
                        "**/node_modules/**",
                        "**/.github/**"
                    ],
                    "description": "扫描笔记时忽略的 glob(相对工作区根)。"
                },
                "srs.baseEase": {
                    "type": "number",
                    "default": 250,
                    "description": "SM-2 初始难度(base ease),与 OSR 默认一致。"
                },
                "srs.easyBonus": {
                    "type": "number",
                    "default": 1.3,
                    "description": "Easy 评级间隔加成,与 OSR 默认一致。"
                },
                "srs.lapsesIntervalChange": {
                    "type": "number",
                    "default": 0.5,
                    "description": "Hard 评级间隔系数,与 OSR 默认一致。"
                },
                "srs.maximumInterval": {
                    "type": "number",
                    "default": 36525,
                    "description": "间隔上限(天)。"
                }
            }
        },
        "commands": [
            {
                "command": "srs.reviewDueFlashcards",
                "title": "%srs.command.reviewDue%"
            },
            {
                "command": "srs.reviewAllFlashcards",
                "title": "%srs.command.reviewAll%"
            },
            {
                "command": "srs.openNotesReviewQueue",
                "title": "%srs.command.openQueue%"
            },
            {
                "command": "srs.reviewCurrentNote",
                "title": "%srs.command.reviewNote%",
                "when": "resourceExtname == .md"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "srs",
                    "title": "%srs.view.container%",
                    "icon": "media/srs-icon.svg"
                }
            ]
        },
        "views": {
            "srs": [
                {
                    "id": "srs.dueNotes",
                    "name": "%srs.view.dueNotes%"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "srs.openNotesReviewQueue",
                    "when": "view == srs.dueNotes",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "smoke": "node test/smoke.mjs",
        "package": "npx --yes @vscode/vsce package"
    },
    "devDependencies": {
        "@types/node": "^20.17.0",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "clozecraft": "^0.4.0",
        "highlight.js": "^11.12.0",
        "markdown-it": "^15.0.1"
    }
}
